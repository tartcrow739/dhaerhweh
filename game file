UCLASS()
class YOURGAME_API ABaseBuilding : public AActor
{
    GENERATED_BODY()

public:
    ABaseBuilding();

protected:
    virtual void BeginPlay() override;

public:
    virtual void Tick(float DeltaTime) override;

    UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "Building")
    TSubclassOf<AActor> WallBlueprint;
    
    UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "Building")
    TSubclassOf<AActor> DoorBlueprint;

    UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "Building")
    int WoodCostWall = 10;
    
    UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "Building")
    int MetalCostWall = 5;
    
    UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "Building")
    int NailCostWall = 5;
    
    UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "Building")
    int WoodCostDoor = 15;
    
    UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "Building")
    int MetalCostDoor = 10;
    
    UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "Building")
    int NailCostDoor = 5;

    UFUNCTION(BlueprintCallable, Category = "Building")
    void PlaceStructure(TSubclassOf<AActor> StructureBlueprint, int WoodCost, int MetalCost, int NailCost);

private:
    class APlayerCharacter* PlayerCharacter;
};

#include "BaseBuilding.h"
#include "Kismet/GameplayStatics.h"
#include "Engine/World.h"
#include "PlayerCharacter.h"

ABaseBuilding::ABaseBuilding()
{
    PrimaryActorTick.bCanEverTick = true;
}

void ABaseBuilding::BeginPlay()
{
    Super::BeginPlay();
    PlayerCharacter = Cast<APlayerCharacter>(UGameplayStatics::GetPlayerCharacter(GetWorld(), 0));
}

void ABaseBuilding::Tick(float DeltaTime)
{
    Super::Tick(DeltaTime);
}

void ABaseBuilding::PlaceStructure(TSubclassOf<AActor> StructureBlueprint, int WoodCost, int MetalCost, int NailCost)
{
    if (PlayerCharacter && PlayerCharacter->Wood >= WoodCost && PlayerCharacter->Metal >= MetalCost && PlayerCharacter->Nails >= NailCost)
    {
        FVector SpawnLocation = PlayerCharacter->GetActorLocation() + PlayerCharacter->GetActorForwardVector() * 200.f;
        FRotator SpawnRotation = PlayerCharacter->GetActorRotation();
        GetWorld()->SpawnActor<AActor>(StructureBlueprint, SpawnLocation, SpawnRotation);

        PlayerCharacter->Wood -= WoodCost;
        PlayerCharacter->Metal -= MetalCost;
        PlayerCharacter->Nails -= NailCost;
    }
    else
    {
        UE_LOG(LogTemp, Warning, TEXT("Not enough materials to build!"));
    }
}

